#!/usr/bin/env bash
#
# The last check before anything leaves the machine.
#
# The bench is seconds, not minutes -- it runs headless under luajit with the
# widget layer stubbed -- so there is no reason to let a push go out untested
# and find out from CI.
#

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# `make ci` and not `make verify`: this hook exists so that a push cannot fail
# on GitHub for something the machine could have said first, and that only holds
# if the two run the same thing. The workflows call this same target.
echo "[pre-push] running everything CI runs"
make ci
echo "[pre-push] ok"
