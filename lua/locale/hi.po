msgid "Cut"
msgstr "काटें"

msgid "Paste"
msgstr "चिपकाएँ"

msgid "Copy"
msgstr "प्रतिलिपि बनाएँ"

msgid "XOPP"
msgstr "XOPP"

msgid "PDF"
msgstr "PDF"

msgid "Nothing here yet — use New notebook to start one"
msgstr "यहाँ अभी कुछ नहीं है — शुरू करने के लिए नया नोटबुक का उपयोग करें"

msgid "Last edited"
msgstr "अंतिम बार संपादित"

msgid "Least recently edited"
msgstr "सबसे पहले संपादित"

msgid "Name (A to Z)"
msgstr "नाम (A से Z)"

msgid "Name (Z to A)"
msgstr "नाम (Z से A)"

msgid "New notebook"
msgstr "नया नोटबुक"

msgid "New folder"
msgstr "नया फ़ोल्डर"

msgid "Annotate PDF"
msgstr "PDF पर टिप्पणी करें"

msgid "Select"
msgstr "चुनें"

msgid "Notebooks"
msgstr "नोटबुक"

msgid "None"
msgstr "कोई नहीं"

msgid "All"
msgstr "सभी"

msgid "1 selected"
msgstr "1 चयनित"

msgid "%1 selected"
msgstr "%1 चयनित"

msgid "Page %1 of %2"
msgstr "पृष्ठ %1 / %2"

msgid "Open this XOPP file with Xournal++."
msgstr "इस XOPP फ़ाइल को Xournal++ से खोलें।"

msgid "The name cannot be empty."
msgstr "नाम खाली नहीं हो सकता।"

msgid "The name cannot contain slashes."
msgstr "नाम में स्लैश नहीं हो सकते।"

msgid "Something with that name is already here."
msgstr "इस नाम का एक आइटम पहले से मौजूद है।"

msgid "That name is too long."
msgstr "वह नाम बहुत लंबा है।"

msgid "That name cannot be used."
msgstr "उस नाम का उपयोग नहीं किया जा सकता।"

msgid "Cancel"
msgstr "रद्द करें"

msgid "Save"
msgstr "सहेजें"

msgid "Export"
msgstr "निर्यात करें"

msgid "Xournal++"
msgstr "Xournal++"

msgid "Choose a PDF file."
msgstr "एक PDF फ़ाइल चुनें।"

msgid "Could not open this PDF."
msgstr "इस PDF को खोला नहीं जा सका।"

msgid "Could not save the notebook."
msgstr "नोटबुक को सहेजा नहीं जा सका।"

msgid "Work"
msgstr "काम"

msgid "Personal"
msgstr "व्यक्तिगत"

msgid "Open"
msgstr "खोलें"

msgid "Rename"
msgstr "नाम बदलें"

msgid "Move"
msgstr "स्थानांतरित करें"

msgid "Send"
msgstr "भेजें"

msgid "Duplicate"
msgstr "प्रतिलिपि बनाएँ"

msgid "Delete"
msgstr "हटाएँ"

msgid ""
"Delete '%1'?\n"
"\n"
"This cannot be undone."
msgstr ""
"«%1» हटाएँ?\n"
"\n"
"इसे पूर्ववत नहीं किया जा सकता।"

msgid ""
"Delete %1 items?\n"
"\n"
"Folders are deleted with everything in them. This cannot be undone."
msgstr ""
"%1 आइटम हटाएँ?\n"
"\n"
"फ़ोल्डरों को उनकी सभी सामग्री सहित हटा दिया जाएगा। इसे पूर्ववत नहीं किया जा सकता।"

msgid "Sort by"
msgstr "क्रमबद्ध करें"

msgid "Rename folder"
msgstr "फ़ोल्डर का नाम बदलें"

msgid "Rename notebook"
msgstr "नोटबुक का नाम बदलें"

msgid "There is nowhere to prepare the files for sending."
msgstr "फ़ाइलों को भेजने के लिए तैयार करने की कोई जगह नहीं है।"

msgid "Preparing '%1'…"
msgstr "«%1» तैयार किया जा रहा है…"

msgid "Preparing %1 items…"
msgstr "%1 आइटम तैयार किए जा रहे हैं…"

msgid "Nothing could be prepared for sending."
msgstr "भेजने के लिए कुछ भी तैयार नहीं किया जा सका।"

msgid "Sending %1; %2 could not be read."
msgstr "%1 भेजा जा रहा है; %2 को पढ़ा नहीं जा सका।"

msgid "Exporting '%1'…"
msgstr "«%1» निर्यात किया जा रहा है…"

msgid "Exporting %1 notebooks…"
msgstr "%1 नोटबुक निर्यात की जा रही हैं…"

msgid "Export cancelled."
msgstr "निर्यात रद्द कर दिया गया।"

msgid ""
"Xournal++ needs both files. Keep them together:\n"
"%1\n"
"%2"
msgstr ""
"Xournal++ को दोनों फ़ाइलों की आवश्यकता है। उन्हें एक साथ रखें:\n"
"%1\n"
"%2"

msgid ""
"Exported to:\n"
"%1"
msgstr ""
"यहाँ निर्यात किया गया:\n"
"%1"

msgid "Exported %1 notebooks."
msgstr "%1 नोटबुक निर्यात की गईं।"

msgid "Exported %1 of %2; %3 could not be read."
msgstr "%2 में से %1 निर्यात की गईं; %3 को पढ़ा नहीं जा सका।"

msgid "Notebooks (top level)"
msgstr "नोटबुक (शीर्ष स्तर)"

msgid "Move to"
msgstr "यहाँ ले जाएँ"

msgid "Moved %1; %2 could not be moved there."
msgstr "%1 स्थानांतरित किया गया; %2 को वहाँ स्थानांतरित नहीं किया जा सका।"

msgid "Edit"
msgstr "संपादित करें"

msgid "Close"
msgstr "बंद करें"

msgid "Open notebook"
msgstr "नोटबुक खोलें"

msgid "Notebook"
msgstr "नोटबुक"

msgid ""
"Notebook encountered an error. Restart KOReader to reopen it; see notebook-"
"error.log for details."
msgstr ""
"नोटबुक प्लगइन में कोई त्रुटि आई। इसे पुनः खोलने के लिए KOReader को पुनरारंभ करें; विवरण के "
"लिए notebook-error.log देखें।"

msgid "Could not create the notebook folder."
msgstr "नोटबुक फ़ोल्डर नहीं बनाया जा सका।"

msgid "This notebook could not be opened; it may be from a newer version."
msgstr "इस नोटबुक को खोला नहीं जा सका; यह शायद किसी नए संस्करण से है।"

msgid "Notebook name"
msgstr "नोटबुक का नाम"

msgid "Create"
msgstr "बनाएँ"

msgid "Fineliner"
msgstr "फाइनलाइनर"

msgid "Fountain pen"
msgstr "फाउंटेन पेन"

msgid "Pencil"
msgstr "पेंसिल"

msgid "Straight line"
msgstr "सीधी रेखा"

msgid "Pause at the end of a stroke"
msgstr "स्ट्रोक के अंत में रुकें"

msgid "Arrow (straight or curved)"
msgstr "तीर (सीधा या घुमावदार)"

msgid "Black"
msgstr "काला"

msgid "White"
msgstr "सफ़ेद"

msgid "Color"
msgstr "रंग"

msgid "Pen type"
msgstr "पेन का प्रकार"

msgid "Marker size"
msgstr "मार्कर का आकार"

msgid "Whole strokes"
msgstr "संपूर्ण स्ट्रोक"

msgid "Part of a stroke"
msgstr "स्ट्रोक का हिस्सा"

msgid "Eraser size"
msgstr "इरेज़र का आकार"

msgid "Square"
msgstr "वर्ग"

msgid "Rectangle"
msgstr "आयत"

msgid "Circle"
msgstr "वृत्त"

msgid "Shapes"
msgstr "आकृतियाँ"

msgid "Small"
msgstr "छोटा"

msgid "Medium"
msgstr "मध्यम"

msgid "Large"
msgstr "बड़ा"

msgid "Sans-serif"
msgstr "सैंस-सेरिफ़"

msgid "Serif"
msgstr "सेरिफ़"

msgid "Monospace"
msgstr "मोनोस्पेस"

msgid "Bold"
msgstr "गहरा"

msgid "Italic"
msgstr "तिरछा"

msgid "Underline"
msgstr "रेखांकित"

msgid "Background"
msgstr "पृष्ठभूमि"

msgid "Transparent"
msgstr "पारदर्शी"

msgid "Text options"
msgstr "पाठ विकल्प"

msgid "Edit text"
msgstr "पाठ संपादित करें"

msgid "Insert text"
msgstr "पाठ डालें"

msgid "Could not save the notebook. It has been left open."
msgstr "नोटबुक को सहेजा नहीं जा सका। इसे खुला छोड़ दिया गया है।"

msgid "Pages (%1)"
msgstr "पृष्ठ (%1)"

msgid "New page"
msgstr "नया पृष्ठ"

msgid "Notebook background"
msgstr "नोटबुक की पृष्ठभूमि"

msgid "Done"
msgstr "पूर्ण"

msgid "Go to this page"
msgstr "इस पृष्ठ पर जाएँ"

msgid "Insert a page after this one"
msgstr "इसके बाद एक पृष्ठ डालें"

msgid "Background of this page"
msgstr "इस पृष्ठ की पृष्ठभूमि"

msgid "Delete page %1 and everything on it?"
msgstr "पृष्ठ %1 और उसकी सभी सामग्री हटाएँ?"

msgid "Page %1"
msgstr "पृष्ठ %1"

msgid "Background of page %1"
msgstr "पृष्ठ %1 की पृष्ठभूमि"

msgid "Follow the notebook again"
msgstr "नोटबुक का फिर से अनुसरण करें"

msgid "Background for every page"
msgstr "प्रत्येक पृष्ठ के लिए पृष्ठभूमि"

msgid "Some pages have their own — change those too"
msgstr "कुछ पृष्ठों की अपनी पृष्ठभूमि है — उन्हें भी बदलें"

msgid ""
"The notebook plugin hit a problem and has closed.\n"
"\n"
"KOReader itself is fine.\n"
"\n"
"Details were written to:\n"
"%1"
msgstr ""
"नोटबुक प्लगइन में कोई समस्या आई और वह बंद हो गया।\n"
"\n"
"KOReader ठीक काम कर रहा है।\n"
"\n"
"विवरण यहाँ लिखे गए:\n"
"%1"

msgid ""
"The notebook plugin hit a problem and has closed.\n"
"\n"
"KOReader itself is fine."
msgstr ""
"नोटबुक प्लगइन में कोई समस्या आई और वह बंद हो गया।\n"
"\n"
"KOReader ठीक काम कर रहा है।"

msgid "Sharing format"
msgstr "साझाकरण प्रारूप"

msgid "Finger"
msgstr "उँगली"

msgid "Turns pages"
msgstr "पृष्ठ पलटता है"

msgid "Draws"
msgstr "चित्र बनाता है"

msgid "Blank"
msgstr "खाली"

msgid "Lined"
msgstr "रेखांकित"

msgid "Narrow lined"
msgstr "संकीर्ण रेखांकित"

msgid "Grid"
msgstr "ग्रिड"

msgid "Dot grid"
msgstr "डॉट ग्रिड"

msgid "Checklist"
msgstr "चेकलिस्ट"

msgid "Ink"
msgstr "स्याही"

msgid "Eraser"
msgstr "रबड़"

msgid "Lasso"
msgstr "लासो"

msgid "Input"
msgstr "इनपुट"

msgid "Tuning written to the log"
msgstr "समायोजन लॉग में लिखे गए"

msgid "Test notebook - rename it if you are not tuning"
msgstr "परीक्षण नोटबुक — समायोजन न कर रहे हों तो इसका नाम बदलें"

msgid "Reset tab"
msgstr "टैब रीसेट करें"

msgid "Reset all"
msgstr "सभी रीसेट करें"

msgid "Write to log"
msgstr "लॉग में लिखें"

msgid "Preparing…"
msgstr "तैयारी हो रही है…"

msgid "Cancelling…"
msgstr "रद्द किया जा रहा है…"

msgid "Exporting PDF…"
msgstr "PDF निर्यात हो रहा है…"

msgid "Rendering"
msgstr "रेंडर हो रहा है"

msgid "Preparing image"
msgstr "छवि तैयार हो रही है"

msgid "Compressing"
msgstr "संपीड़न जारी है"

msgid "Page %1 of %2 — %3"
msgstr "पृष्ठ %1 / %2 — %3"

