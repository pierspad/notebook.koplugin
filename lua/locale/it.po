msgstr "Sposta"

msgid "Move to"
msgstr "Sposta in"

msgid "Moved %1; %2 could not be moved there."
msgstr "Spostati %1; %2 non potevano andare lì."

msgid "Name (A to Z)"
msgstr "Nome (dalla A alla Z)"

msgid "Name (Z to A)"
msgstr "Nome (dalla Z alla A)"

msgid "Narrow lined"
msgstr "Righe strette"

msgid "New folder"
msgstr "Nuova cartella"

msgid "New notebook"
msgstr "Nuovo blocco note"

msgid "New page"
msgstr "Nuova pagina"

msgid "Nothing could be prepared for sending."
msgstr "Non è stato possibile preparare nulla per l'invio."

msgid "None"
msgstr "Nessuno"

msgid "Notebook"
msgstr "Blocco note"

msgid "Notebook background"
msgstr "Sfondo del blocco note"

msgid "Notebook name"
msgstr "Nome del blocco note"

msgid "Notebooks"
msgstr "Blocchi note"

msgid "Notebooks (top level)"
msgstr "Blocchi note (livello principale)"

msgid "Nothing here yet — use New notebook to start one"
msgstr "Ancora niente — usa Nuovo blocco note per cominciare"

msgid "Open"
msgstr "Apri"

msgid "Open notebook"
msgstr "Apri blocco note"

msgid "PDF"
msgstr "PDF"

msgid "Page %1"
msgstr "Pagina %1"

msgid "Page %1 of %2"
msgstr "Pagina %1 di %2"

msgid "Pages (%1)"
msgstr "Pagine (%1)"

msgid "Part of a stroke"
msgstr "Parte di un tratto"

msgid "Paste"
msgstr "Incolla"

msgid "Pen size"
msgstr "Dimensione penna"

msgid "Preparing %1 items…"
msgstr "Preparazione di %1 elementi…"

msgid "Preparing '%1'…"
msgstr "Preparazione di «%1»…"

msgid "Rename"
msgstr "Rinomina"

msgid "Rename folder"
msgstr "Rinomina cartella"

msgid "Rename notebook"
msgstr "Rinomina blocco note"

msgid "Save"
msgstr "Salva"

msgid "Select"
msgstr "Seleziona"

msgid "Send"
msgstr "Invia"

msgid "Sending %1; %2 could not be read."
msgstr "Invio di %1; %2 non sono leggibili."

msgid "Some pages have their own — change those too"
msgstr "Alcune pagine hanno il proprio — cambia anche quelle"

msgid "Something with that name is already here."
msgstr "Qui c'è già qualcosa con questo nome."

msgid "Sort by"
msgstr "Ordina per"

msgid "That name cannot be used."
msgstr "Questo nome non si può usare."

msgid "That name is too long."
msgstr "Questo nome è troppo lungo."

msgid "The name cannot be empty."
msgstr "Il nome non può essere vuoto."

msgid "The name cannot contain slashes."
msgstr "Il nome non può contenere barre."

msgid "The notebook plugin hit a problem and has closed.\n\nKOReader itself is fine."
msgstr "Il plugin dei blocchi note ha avuto un problema e si è chiuso.\n\nKOReader sta bene."

msgid "The notebook plugin hit a problem and has closed.\n\nKOReader itself is fine.\n\nDetails were written to:\n%1"
msgstr "Il plugin dei blocchi note ha avuto un problema e si è chiuso.\n\nKOReader sta bene.\n\nI dettagli sono stati scritti in:\n%1"

msgid "There is nowhere to prepare the files for sending."
msgstr "Non c'è spazio dove preparare i file per l'invio."

msgid "This notebook could not be opened; it may be from a newer version."
msgstr "Impossibile aprire questo blocco note; potrebbe venire da una versione più recente."

msgid "Turns pages"
msgstr "Gira pagina"

msgid "Whole strokes"
msgstr "Tratti interi"
