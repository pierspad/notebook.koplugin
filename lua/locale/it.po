# Italian translations for the Scribe notebook plugin.
#
# One entry per string the plugin shows. Copy this file to <language>.po and
# translate the msgstr lines to add a language; nothing else needs changing.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: it\n"

msgid "%1 selected"
msgstr "%1 selezionati"

msgid "1 selected"
msgstr "1 selezionato"

msgid "Add"
msgstr "Aggiungi"

msgid "All"
msgstr "Tutti"

msgid "Background for every page"
msgstr "Sfondo per ogni pagina"

msgid "Background of page %1"
msgstr "Sfondo della pagina %1"

msgid "Background of this page"
msgstr "Sfondo di questa pagina"

msgid "Blank"
msgstr "Bianco"

msgid "Cancel"
msgstr "Annulla"

msgid "Checklist"
msgstr "Elenco"

msgid "Close"
msgstr "Chiudi"

msgid "Copy"
msgstr "Copia"

msgid "Could not create the notebook folder."
msgstr "Impossibile creare la cartella dei blocchi note."

msgid "Create"
msgstr "Crea"

msgid "Cut"
msgstr "Taglia"

msgid "Delete"
msgstr "Elimina"

msgid "Delete %1 items?\n\nFolders are deleted with everything in them. This cannot be undone."
msgstr "Eliminare %1 elementi?\n\nLe cartelle vengono eliminate con tutto il loro contenuto. L'operazione non è annullabile."

msgid "Delete '%1'?\n\nThis cannot be undone."
msgstr "Eliminare «%1»?\n\nL'operazione non è annullabile."

msgid "Delete page %1 and everything on it?"
msgstr "Eliminare la pagina %1 e tutto ciò che contiene?"

msgid "Done"
msgstr "Fatto"

msgid "Dot grid"
msgstr "Puntini"

msgid "Draws"
msgstr "Disegna"

msgid "Duplicate"
msgstr "Duplica"

msgid "Eraser removes"
msgstr "La gomma cancella"

msgid "Eraser size"
msgstr "Dimensione gomma"

msgid "Export PDF"
msgstr "Esporta PDF"

msgid "Exported %1 notebooks."
msgstr "Esportati %1 blocchi note."

msgid "Exported %1 of %2; %3 could not be read."
msgstr "Esportati %1 di %2; %3 non sono leggibili."

msgid "Exported to:\n%1"
msgstr "Esportato in:\n%1"

msgid "Exporting %1 notebooks…"
msgstr "Esportazione di %1 blocchi note…"

msgid "Exporting '%1'…"
msgstr "Esportazione di «%1»…"

msgid "Finger"
msgstr "Dito"

msgid "Follow the notebook again"
msgstr "Torna a seguire il blocco note"

msgid "Go to this page"
msgstr "Vai a questa pagina"

msgid "Grid"
msgstr "Quadretti"

